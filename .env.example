# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastapi_db

# Security & Authentication
NEXTAUTH_INTERNAL_SECRET=change-me-to-a-secure-random-secret
JWT_SECRET_KEY=change-me-to-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Application
APP_NAME=RAG LAB
DEBUG=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI / LLM Provider Keys
HF_TOKEN=hf_your_token_here
GROQ_API_KEY=gsk_your_key_here
GOOGLE_API_KEY=your_google_key_here
OPENAI_API_KEY=sk_your_openai_key_here

# Model Preloading Configuration
# Set to 'true' to preload all supported embedding and reranking models at boot
PRELOAD_ALL_MODELS=false

# Or specify individual models (comma-separated, 'all', or 'none')
# Supported embedding models: BAAI/bge-large-en-v1.5, all-MiniLM-L6-v2
PRELOAD_EMBEDDING_MODELS=none

# Supported reranking models: BAAI/bge-reranker-base, BAAI/bge-reranker-large
PRELOAD_RERANKING_MODELS=none
